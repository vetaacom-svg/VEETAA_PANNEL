# Copier vers .env et remplir avec les valeurs du tableau Supabase : Paramètres du projet → API
# Ne jamais committer .env ni exposer la clé service_role dans le dépôt ou le bundle front.

# URL du projet (Project URL)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique anon uniquement — la service_role ne doit exister que côté serveur (Edge Function, backend).
VITE_SUPABASE_ANON_KEY=votre_cle_anon
